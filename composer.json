{
    "name": "najmulhasanbd/laravel-custom-toastr",
    "description": "A beautifully designed, highly customizable, and easy-to-use Toastr notification package for Laravel. Includes multiple animations, progress bars, and dynamic positioning.",
    "keywords": [
        "laravel custom toastr",
        "laravel notification message",
        "laravel toastr",
        "laravel toastr message",
        "laravel",
        "toastr",
        "toast",
        "notification",
        "alert",
        "flash message",
        "custom-toastr",
        "message",
        "ui"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Md Najmul Hasan",
            "email": "najmulcse247@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Najmul\\CustomToastr\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Najmul\\CustomToastr\\CustomToastrServiceProvider"
            ],
            "aliases": {
                "Toastr": "Najmul\\CustomToastr\\Facades\\Toastr"
            }
        }
    }
}